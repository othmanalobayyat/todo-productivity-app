# ──────────────────────────────────────────────────────────────
# Frontend Environment — React Native (Expo)
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# Full URL of the active backend API.
#
# Primary backend (Node.js / Express — port 3000):
#   Use your machine's local IP when testing on a physical device.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:3000/api
#
#   For Android emulator:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
#
#   For iOS simulator:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
#
# Alternative backend (Laravel — port 8000): replace 3000 with 8000 above.
#
# Production (Render-hosted Node backend):
#   EXPO_PUBLIC_API_BASE_URL=https://your-backend.onrender.com/api

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.x:3000/api

# Cloudinary — avatar uploads (unsigned upload preset)
# Create a free account at cloudinary.com, then create an unsigned upload preset.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Web Push (iPhone PWA reminders) — the VAPID *public* key only (safe to
# expose). Must match VAPID_PUBLIC_KEY in the backend's .env. Generate a pair
# with `npx web-push generate-vapid-keys` in to-do-app-backend-node/.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
